rules_version = '2';

// Este app NÃO usa o Firebase Authentication (não foi ativado no console
// deste projeto). O login é próprio: conta em holyrics_accounts (e-mail
// como id, senha nunca em texto puro — só o hash PBKDF2 e o sal), perfil
// em holyrics_members. Sem uid de sessão do Firebase, o Firestore não tem
// como saber "quem" está pedindo — por isso não dá pra restringir por
// pessoa como seria com o Auth nativo.
//
// O que estas regras protegem de verdade: ninguém de fora reconstrói a
// senha de ninguém a partir do banco (o hash já cuida disso sozinho, mas
// o campo fica de leitura restrita como reforço) e apenas quem sabe a
// senha de uma conta 'equipe' — verificado no app antes de gravar —
// consegue editar conteúdo. É a mesma proteção de antes (regras abertas),
// com a diferença de exigir login para participar do app.

service cloud.firestore {
  match /databases/{database}/documents {
    match /holyrics_accounts/{email} {
      allow read: if false;   // ninguém lê hash nem sal de fora do app
      allow write: if true;   // criar conta / trocar senha acontece sem sessão do Firestore
    }
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
